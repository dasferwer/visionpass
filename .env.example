VISIONPASS_PORT=8050
VISIONPASS_DATABASE_URL=postgresql+psycopg://visionpass:visionpass@database:5432/visionpass
VISIONPASS_RABBITMQ_URL=amqp://visionpass:visionpass@rabbitmq:5672/%2F
VISIONPASS_JWT_SECRET=replace-with-a-long-random-secret
VISIONPASS_ADMIN_EMAIL=admin@example.com
VISIONPASS_ADMIN_PASSWORD=ChangeMe123!
VISIONPASS_REVIEWER_EMAIL=reviewer@example.com
VISIONPASS_REVIEWER_PASSWORD=ChangeMe123!
# stub is deterministic and intended only for local demo/tests.
# Use face_recognition with an image built from Dockerfile target cv.
VISIONPASS_MATCHER_BACKEND=stub
VISIONPASS_MATCH_THRESHOLD=0.60
VISIONPASS_REVIEW_MARGIN=0.12
VISIONPASS_MAX_IMAGE_BYTES=5242880
VISIONPASS_LOG_LEVEL=INFO
